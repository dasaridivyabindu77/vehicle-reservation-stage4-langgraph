# ---- LLM Provider Configuration ----
# Choose one: DIAL (Azure-OpenAI compatible) or standard OpenAI
# Leave API keys empty to run fully OFFLINE (deterministic hashing embeddings,
# extractive answers). Tests and CI run in this offline mode.

# Provider type: "dial" or "openai" (default: dial)
LLM_PROVIDER=dial

# EPAM DIAL (Azure-OpenAI compatible)
DIAL_API_KEY=
DIAL_ENDPOINT=https://ai-proxy.lab.epam.com
DIAL_API_VERSION=2024-02-01
# DIAL *deployment* names (not raw model ids)
DIAL_CHAT_MODEL=gpt-4o
DIAL_EMBEDDING_MODEL=text-embedding-3-small-1

# Standard OpenAI
OPENAI_API_KEY=
# OpenAI model names (not deployment names)
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Weaviate (static knowledge vector store) ----
# When unreachable, the app automatically falls back to an in-process vector store.
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# ---- Dynamic data (availability / prices / hours) ----
SQLITE_PATH=citypark.db

# ---- Retrieval & grounding ----
TOP_K=4
RELEVANCE_MIN_OVERLAP=0.12
RELEVANCE_MIN_SCORE=0.30
EMBEDDING_DIM=256

# ---- Stage 2: Administrator approval (human-in-the-loop) ----
ADMIN_NAME=CityPark Administrator
ADMIN_EMAIL=
# Required for the admin dashboard API; generate a private token before using it.
ADMIN_TOKEN=

# Optional SMTP email escalation (only activates when SMTP_HOST and ADMIN_EMAIL are both set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=True

# ---- Stage 3: MCP server for confirmed reservation persistence ----
MCP_SERVER_URL=http://127.0.0.1:8001
MCP_SERVER_TOKEN=
MCP_ENABLED=True
